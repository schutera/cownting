# --- Cownting production secrets & settings ---
# Copy this file to `.env` and fill it in. `.env` is gitignored — never commit it.
#
#   cp .env.example .env

# Signing key for the login session cookie. Restarts stay logged in as long as
# this is stable. Generate one with:
#   openssl rand -hex 32
COWNTING_SECRET=

# Bootstrap admin account — created on FIRST boot only, when the user table is
# empty. Change the password after first login (or manage users in the Admin page).
COWNTING_ADMIN_USER=admin
COWNTING_ADMIN_PASSWORD=

# Public address Caddy serves on:
#   - a domain (e.g. cownting.example.com) -> automatic HTTPS via Let's Encrypt
#     (point the domain's DNS A/AAAA record at this server first)
#   - ":80"                                -> plain HTTP only (testing)
# When you use a real domain over HTTPS, also set `auth.https_only: true` in
# config/cownting.prod.yaml so the session cookie is HTTPS-only.
CADDY_SITE_ADDRESS=:80

# Discord webhook the weekly label backup posts to (turned on with `backup.enabled:
# true` in config/cownting.prod.yaml). OPTIONAL: leaving it blank — or leaving the
# line out entirely — is a supported state, not an error. The backup still runs,
# zips and rotates locally; it just posts nothing. For the same reason it must NOT
# be wired into docker-compose's `environment:` as ${COWNTING_DISCORD_WEBHOOK:?},
# which would turn an unset webhook into a hard boot failure; `env_file: .env`
# already injects it.
#
# Point it at a channel chosen for this. The zip contains annotator usernames and
# per-annotator timings, and the first run posts the whole store at once — so not
# the login-alerts webhook already on this host at alerts/webhook.url.
#
# This URL is a credential: anyone holding it can post to the channel. `.env` is
# gitignored — never commit it, and never move this value into a YAML under config/.
COWNTING_DISCORD_WEBHOOK=
